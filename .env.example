# City Hospital Pune - Environment Configuration Template
# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=city-hospital-pune-secure-jwt-secret-2026
CORS_ORIGIN=http://localhost:3000

# SQLite Persistent Database
DATABASE_URL="file:./dev.db"

# Optional External AI API Key (Gemini)
# If left empty, system operates in deterministic clinical decision support demo mode
GEMINI_API_KEY=""
AI_API_KEY=""

# Clinical Emergency Numbers (India)
EMERGENCY_HELPLINE_INDIA="112"
HOSPITAL_EMERGENCY_DESK="+91 20 2567 8900"
